<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Standort: nötig für GPS-Tracking der Fahrten -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Automatische Fahrterkennung -->
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Damit Tracking weiterläuft, auch wenn die App im Hintergrund ist -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Automatischer Aufzeichnungsstart bei Verbindung mit dem Auto-Radio -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DriveTrack"
        android:theme="@style/Theme.DriveTrack"
        android:supportsRtl="true">

        <!-- Android Auto: minimal unterstützte Car-API-Version -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Bildausschnitt beim Fahrzeug-Foto: die Lib ist View-basiert und verlangt zwingend ein
             Theme.AppCompat-Theme, das der Rest der App (reines Compose/Material3) sonst nirgends
             braucht - deshalb Theme-Override nur für diese eine Activity (siehe themes.xml). -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/CropperTheme" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DriveTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Erscheint im Teilen-Menü anderer Apps, wenn eine .gpx-Datei geteilt wird -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
            </intent-filter>

            <!-- Ermöglicht "Öffnen mit DriveTrack" direkt aus dem Dateimanager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/gpx+xml" />
            </intent-filter>
        </activity>

        <!-- Android-Auto-Einstiegspunkt. Kategorie IOT statt (bis 0.16.0) POI: DriveTrack zeigt keine
             Orte/Points-of-Interest an, sondern startet/überwacht eine GPS-Aufzeichnung - das
             entspricht laut offizieller Doku genau der Beschreibung von IOT-Apps
             (developer.android.com/training/cars/apps/iot, dortiges Beispiel nutzt exakt dieselbe
             Kombination aus CarAppService + PaneTemplate wie RecordingCarScreen.kt hier). POI ist
             für Apps gedacht, deren Root-Screen eine Orts-/Karten-Liste zeigt (PlaceListMapTemplate/
             MapWithContentTemplate) - vermutlich der Grund, warum die App trotz korrekt aktivierter
             "Unbekannte Quellen"-Einstellung nie im Android-Auto-Launcher erschienen ist. -->
        <service
            android:name=".car.DriveTrackCarAppService"
            android:exported="true"
            android:foregroundServiceType="location">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Foreground Service: verhindert GPS-Drosselung während der Aufzeichnung -->
        <service
            android:name=".tracking.TripTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Startet Aufzeichnung automatisch bei Verbindung zu einem Auto zugeordneten Bluetooth-Gerät.
             exported=true ist hier nötig, ACL_CONNECTED ist aber ein von Android geschützter
             "protected broadcast" und kann trotzdem nur vom System gesendet werden. -->
        <receiver
            android:name=".tracking.BluetoothConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Nur für den "Verwerfen"-Button in der Aufzeichnungs-Notification, per PendingIntent
             ausgelöst -> muss nicht exportiert sein. -->
        <receiver
            android:name=".tracking.DiscardRecordingReceiver"
            android:exported="false" />

        <!-- Nur für den Start-Button in der Bluetooth-Vorschlags-Notification, per PendingIntent
             ausgelöst -> muss nicht exportiert sein. -->
        <receiver
            android:name=".tracking.StartRecordingFromNotificationReceiver"
            android:exported="false" />

        <!-- FileProvider für den GPX-Export (sicheres Teilen von Dateien mit anderen Apps) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
