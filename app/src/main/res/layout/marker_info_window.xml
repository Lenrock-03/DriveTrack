<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_marker_info_window"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:minWidth="140dp">

    <TextView
        android:id="@+id/infoWindowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF7A1A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/infoWindowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#EDE0D4"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/infoWindowSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D6C3B4"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />
</LinearLayout>
